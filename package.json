{
	"name": "r4",
	"version": "0.0.1",
	"repository": "https://github.com/radio4000/r4-svelte",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:standalone": "PUBLIC_APP_MODE=standalone vite build",
		"preview": "vite preview",
		"format": "prettier --write . --log-level=warn",
		"biome": "biome check --write .",
		"lint": "eslint .",
		"check": "bun run format && bun run biome && bun run lint",
		"knip": "knip-bun",
		"types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"i18n": "node i18n/sync.js && bunx @inlang/paraglide-js compile --project ./i18n/project.inlang --outdir ./src/lib/paraglide",
		"i18n:stats": "node i18n/stats.js",
		"i18n:extract": "node i18n/extract.js",
		"i18n:review": "node i18n/review.js",
		"i18n:check": "node i18n/check.js",
		"i18n:prune-unused": "node i18n/prune-unused.js",
		"i18n:apply": "node i18n/apply-batch.js"
	},
	"overrides": {
		"vite": "^8.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@e18e/eslint-plugin": "^0.5.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.69.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.4",
		"@tanstack/eslint-plugin-query": "^5.101.2",
		"@types/eslint": "^9.6.1",
		"@types/youtube": "^0.3.0",
		"@vite-pwa/sveltekit": "^1.1.0",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"knip": "^6.25.0",
		"prettier": "^3.9.4",
		"prettier-plugin-svelte": "^4.1.1",
		"rollup-plugin-visualizer": "^7.0.0",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0",
		"vite": "^8.1.3",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.1.10",
		"workbox-window": "^7.4.1"
	},
	"dependencies": {
		"@humanspeak/svelte-virtual-list": "^0.5.9",
		"@inlang/paraglide-js": "^2.20.2",
		"@inlang/plugin-m-function-matcher": "^2.2.9",
		"@inlang/plugin-message-format": "^4.4.0",
		"@radio4000/sdk": "^0.8.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@tanstack/query-core": "^5.101.2",
		"@tanstack/query-db-collection": "^1.0.46",
		"@tanstack/query-persist-client-core": "^5.101.2",
		"@tanstack/svelte-db": "^0.1.91",
		"@tanstack/svelte-query": "^6.1.36",
		"@tanstack/svelte-query-devtools": "^6.1.36",
		"adze": "^2.3.0",
		"feed": "^6.0.0",
		"fuzzysort": "^3.1.0",
		"gsap": "^3.14.2",
		"idb-keyval": "^6.2.6",
		"lil-gui": "^0.21.0",
		"luxon": "^3.7.2",
		"maplibre-gl": "^5.24.0",
		"marked": "^18.0.5",
		"media-chrome": "^4.19.2",
		"media-now": "^2.2.3",
		"obra-icons-svelte": "^1.23.1",
		"ogl": "^1.0.11",
		"posthog-js": "^1.398.0",
		"runed": "^0.37.1",
		"svelte-awesome-color-picker": "^4.1.3",
		"tinykeys": "^4.0.0",
		"youtube-video-element": "^1.9.0"
	}
}
