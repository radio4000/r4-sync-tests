{
	"name": "r5",
	"version": "0.0.1",
	"repository": "https://github.com/radio4000/r4-sync-tests",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:standalone": "PUBLIC_APP_MODE=standalone vite build",
		"preview": "vite preview",
		"format": "prettier --write . --log-level=warn",
		"biome": "biome check --write .",
		"lint": "eslint .",
		"check": "bun run format && bun run biome && bun run lint",
		"knip": "knip-bun",
		"types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"i18n": "node i18n/sync.js && bunx @inlang/paraglide-js compile --project ./i18n/project.inlang --outdir ./src/lib/paraglide && node i18n/postcompile.js",
		"i18n:stats": "node i18n/stats.js",
		"i18n:extract": "node i18n/extract.js",
		"i18n:review": "node i18n/review.js",
		"i18n:check": "node i18n/check.js",
		"i18n:prune-unused": "node i18n/prune-unused.js",
		"i18n:apply": "node i18n/apply-batch.js"
	},
	"overrides": {
		"vite": "^8.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@e18e/eslint-plugin": "^0.5.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tanstack/eslint-plugin-query": "^5.100.14",
		"@types/eslint": "^9.6.1",
		"@types/youtube": "^0.2.0",
		"@vite-pwa/sveltekit": "^1.1.0",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.18.0",
		"globals": "^17.6.0",
		"knip": "^6.14.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^4.0.1",
		"rollup-plugin-visualizer": "^7.0.0",
		"svelte": "^5.55.9",
		"svelte-check": "^4.4.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.0",
		"vite": "^8",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.1.7",
		"workbox-window": "^7.4.1",
		"yargs": "^18.0.0"
	},
	"dependencies": {
		"@humanspeak/svelte-virtual-list": "^0.5.0",
		"@inlang/paraglide-js": "^2.18.1",
		"@inlang/plugin-m-function-matcher": "^2.2.6",
		"@inlang/plugin-message-format": "^4.4.0",
		"@radio4000/sdk": "^0.8.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@tanstack/query-core": "^5.100.14",
		"@tanstack/query-db-collection": "^1.0.38",
		"@tanstack/query-persist-client-core": "^5.100.14",
		"@tanstack/svelte-db": "^0.1.84",
		"@tanstack/svelte-query": "^6.1.33",
		"@tanstack/svelte-query-devtools": "^6.1.33",
		"@types/yargs": "^17.0.35",
		"adze": "^2.3.0",
		"feed": "^5.2.1",
		"filenamify": "^7.0.1",
		"fuzzysort": "^3.1.0",
		"gsap": "^3.14.2",
		"idb-keyval": "^6.2.4",
		"lil-gui": "^0.21.0",
		"luxon": "^3.7.2",
		"maplibre-gl": "^5.24.0",
		"marked": "^18.0.4",
		"media-chrome": "^4.18.2",
		"media-now": "^2.2.3",
		"obra-icons-svelte": "^1.23.1",
		"ogl": "^1.0.11",
		"p-limit": "^7.3.0",
		"posthog-js": "^1.376.3",
		"runed": "^0.37.1",
		"svelte-awesome-color-picker": "^4.1.1",
		"tinykeys": "^4.0.0",
		"youtube-video-element": "^1.9.0"
	}
}
