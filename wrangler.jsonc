{
	"name": "r5",
	"account_id": "46bcc6e9a78b2e839068c0685143e1a2",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-02-14",
	// Svelte's async SSR needs AsyncLocalStorage from node:async_hooks.
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare/public"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	}
}
